/* ---------- 日历 ---------- */
async function renderCalendar(container, tasks) {
  const nav = container.createEl("div", { cls: "cal-nav" });
  const prev = nav.createEl("button", { cls:"todo-btn", text: "◀" });
  const title = nav.createEl("span",  { cls:"cal-title", text: `${viewYear} 年 ${viewMonth} 月` });
  const next = nav.createEl("button", { cls:"todo-btn", text: "▶" });
  const tdyB = nav.createEl("button", { cls:"todo-btn", text: "今天" });
  prev.onclick = () => { viewMonth--; if(viewMonth<1){viewMonth=12;viewYear--;} render(); };
  next.onclick = () => { viewMonth++; if(viewMonth>12){viewMonth=1;viewYear++;} render(); };
  tdyB.onclick = () => { viewYear=todayDV.year; viewMonth=todayDV.month; render(); };

  const eventMap = {};
  for (const t of tasks) {
    const q = quadrant(t);
    const color = COLORS[q];
    const push = (date, prefix) => {
      if (!date) return;
      (eventMap[date] ||= []).push({ prefix, text: t.text, color, idx: t.idx, task: t });
    };
    push(fmtDate(t.created),  "Start·");
    push(fmtDate(t.due),      "End·");
    if (t.completed) push(fmtDate(t.done), "✅·");
    push(fmtDate(t.modified), "✍️·");
  }

  const table = container.createEl("table", { cls: "cal-table" });
  const head = table.createEl("tr");
  ["一","二","三","四","五","六","日"].forEach(d => head.createEl("th", { text: d }));

  const first = dv.date(`${viewYear}-${pad(viewMonth)}-01`);
  const startWeekday = first.weekday;
  const daysInMonth  = first.daysInMonth;

  let row = table.createEl("tr");
  for (let i = 1; i < startWeekday; i++) row.createEl("td", { cls: "cal-empty" });

  for (let day = 1; day <= daysInMonth; day++) {
    if ((startWeekday + day - 2) % 7 === 0 && day !== 1) row = table.createEl("tr");
    const cell = row.createEl("td", { cls: "cal-cell" });
    const dateStr = `${viewYear}-${pad(viewMonth)}-${pad(day)}`;
    const isToday = dateStr === todayStr;

    cell.createEl("div", {
      text: String(day),
      cls: "cal-day" + (isToday ? " cal-today":"")
    });

    const events = eventMap[dateStr] || [];
    for (const ev of events) {
      const item = cell.createEl("div", { cls: "cal-item" });
      item.style.background = ev.color;
      item.setText(`${ev.prefix}${ev.text}`);
      item.onclick = (e) => {
        e.stopPropagation();
        openTaskModal({ mode:"edit", task: ev.task, idx: ev.idx, onSaved: render });
      };
    }

    cell.onclick = () => {
      openTaskModal({ mode:"new", defaultDate: dateStr, onSaved: render });
    };
  }
}

/* ---------- 循环续期（含每年） ---------- */
async function runRecurring() {
  const { file, lines } = await readInbox();
  let changed = false;
  const newLines = [];
  const nextDate = (dateStr, rule) => {
    const d = dv.date(String(dateStr).slice(0,10));
    if (!d) return null;
    if (rule === "daily")   return d.plus({days:1}).toFormat("yyyy-MM-dd");
    if (rule === "weekly")  return d.plus({weeks:1}).toFormat("yyyy-MM-dd");
    if (rule === "monthly") return d.plus({months:1}).toFormat("yyyy-MM-dd");
    if (rule === "yearly")  return d.plus({years:1}).toFormat("yyyy-MM-dd");
    return null;
  };

  for (let line of lines) {
    const parsed = parseTaskLine(line);
    if (parsed && parsed.completed && parsed.repeat && !line.includes("[spawned::")) {
      const newDue = nextDate(parsed.due, parsed.repeat);
      if (newDue) {
        line = line.replace(/\s*$/, " [spawned:: true]");
        newLines.push(line);
        const timePart = String(parsed.due).length > 10 ? " " + String(parsed.due).slice(11) : "";
        const next = {
          ...parsed,
          completed:false, done:"", modified:"",
          created: todayStr,
          due: newDue + timePart,
        };
        newLines.push(buildTaskLine(next));
        changed = true;
        continue;
      }
    }
    newLines.push(line);
  }
  if (changed) await app.vault.modify(file, newLines.join("\n"));
}

