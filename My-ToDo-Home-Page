```dataviewjs
/* ============================================================
   一体化主页：四象限 + 日历 + 弹窗表单 + 拖拽 + 过滤
   依赖：仅 Dataview（启用 JavaScript Queries）
   ============================================================ */

/* ⚠️ 改成你 Inbox.md 的实际路径（含文件夹）⚠️
   例：根目录就放 "Inbox.md"
   在 待办 文件夹下就 "待办/Inbox.md" */
const SRC_PATH = "待办/Inbox.md";

const COLORS = { Q1:"#e74c3c", Q2:"#e67e22", Q3:"#f1c40f", Q4:"#95a5a6" };

/* ---------- 工具 ---------- */
const pad = n => String(n).padStart(2,"0");
const todayDV = dv.date('today');
const nowDV   = dv.date('now');
const todayStr = todayDV.toFormat("yyyy-MM-dd");

const isImportant = t => t.important === true;
const isUrgent    = t => t.urgent === true;
const within12h = t => {
  if (!t.due) return false;
  const d = dv.date(String(t.due).replace(" ","T"));
  if (!d) return false;
  const h = (d.ts - nowDV.ts)/3600000;
  return h > 0 && h < 12;
};
const quadrant = t => {
  const imp = isImportant(t);
  const urg = isUrgent(t) || within12h(t);
  if (imp && urg) return "Q1";
  if (imp) return "Q2";
  if (urg) return "Q3";
  return "Q4";
};
const fmtDate = d => d ? String(d).slice(0,10) : null;

const byDue = (a,b) => {
  if (!a.due && !b.due) return 0;
  if (!a.due) return 1;
  if (!b.due) return -1;
  return dv.date(String(a.due).replace(" ","T")).ts
       - dv.date(String(b.due).replace(" ","T")).ts;
};

/* ---------- 文件读写（核心，不依赖 dv.pages） ---------- */
async function readInbox() {
  const file = app.vault.getAbstractFileByPath(SRC_PATH);
  if (!file) {
    throw new Error(`找不到文件：${SRC_PATH}\n请修改代码顶部的 SRC_PATH 变量。`);
  }
  const text = await app.vault.read(file);
  return { file, text, lines: text.split("\n") };
}

function parseTaskLine(line) {
  if (!/^\s*-\s*\[[ xX]\]/.test(line)) return null;
  const completed = /^\s*-\s*\[[xX]\]/.test(line);
  const get = (k) => {
    const m = line.match(new RegExp(`\\[${k}::\\s*([^\\]]*)\\]`));
    return m ? m[1].trim() : "";
  };
  const text = line
    .replace(/^\s*-\s*\[[ xX]\]\s*/, "")
    .replace(/\[[^\[\]]*?::[^\[\]]*?\]/g, "")
    .trim();
  return {
    completed,
    text,
    important: get("important") === "true",
    urgent:    get("urgent") === "true",
    due:       get("due"),
    created:   get("created"),
    done:      get("done"),
    modified:  get("modified"),
    repeat:    get("repeat"),
  };
}

function buildTaskLine(t) {
  const box = t.completed ? "[x]" : "[ ]";
  const fields = [
    `[important:: ${t.important ? "true":"false"}]`,
    `[urgent:: ${t.urgent ? "true":"false"}]`,
    `[due:: ${t.due || ""}]`,
    `[created:: ${t.created || todayStr}]`,
    t.done     ? `[done:: ${t.done}]` : "",
    t.modified ? `[modified:: ${t.modified}]` : "",
    `[repeat:: ${t.repeat || ""}]`,
  ].filter(Boolean).join(" ");
  return `- ${box} ${t.text} ${fields}`;
}

async function writeTaskAtIndex(idx, taskObj) {
  const { file, lines } = await readInbox();
  lines[idx] = buildTaskLine(taskObj);
  await app.vault.modify(file, lines.join("\n"));
}
async function appendTask(taskObj) {
  const { file, text } = await readInbox();
  const newText = text.replace(/\s*$/, "") + "\n" + buildTaskLine(taskObj) + "\n";
  await app.vault.modify(file, newText);
}
async function deleteTaskAtIndex(idx) {
  const { file, lines } = await readInbox();
  lines.splice(idx, 1);
  await app.vault.modify(file, lines.join("\n"));
}

async function loadTasks() {
  const { lines } = await readInbox();
  const tasks = [];
  lines.forEach((line, idx) => {
    const parsed = parseTaskLine(line);
    if (parsed) tasks.push({ idx, raw: line, ...parsed });
  });
  return tasks;
}

