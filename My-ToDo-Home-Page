/* ---------- 过滤函数 ---------- */
function applyFilter(tasks) {
  let list = tasks;
  if (hideDone) list = list.filter(t => !t.completed);
  if (currentFilter === "all") return list;

  const todayTs = todayDV.startOf("day").ts;
  const weekEnd = todayDV.plus({days:7}).ts;

  return list.filter(t => {
    if (!t.due) return false;
    const d = dv.date(String(t.due).replace(" ","T"));
    if (!d) return false;
    if (currentFilter === "today") {
      return d.toFormat("yyyy-MM-dd") === todayStr;
    }
    if (currentFilter === "week") {
      return d.ts >= todayTs && d.ts <= weekEnd;
    }
    if (currentFilter === "over") {
      return d.ts < nowDV.ts && !t.completed;
    }
    return true;
  });
}

/* ---------- 渲染 ---------- */
async function render() {
  content.innerHTML = "";
  statusBar.classList.remove("todo-error");

  let tasks;
  try {
    tasks = await loadTasks();
    statusBar.setText(`✅ 已加载 ${tasks.length} 个任务（来源：${SRC_PATH}）`);
  } catch (err) {
    statusBar.classList.add("todo-error");
    statusBar.setText("❌ " + err.message);
    return;
  }

  const filtered = applyFilter(tasks);

  if (currentTab === "q" || currentTab === "both") {
    await renderQuadrants(content, filtered);
  }
  if (currentTab === "c" || currentTab === "both") {
    if (currentTab === "both") content.createEl("hr");
    // 日历不应用 today/week 这种过滤（日历需要看全月），但 hideDone 仍生效
    const calTasks = hideDone ? tasks.filter(t => !t.completed) : tasks;
    await renderCalendar(content, calTasks);
  }
}

/* ---------- 四象限 + 拖拽 ---------- */
async function renderQuadrants(container, tasks) {

  // 不再过滤 completed，让已完成的也参与象限分类

  const all = tasks; // 已经在外层 applyFilter 处理过 hideDone

  const Q1 = all.filter(t => isImportant(t) &&  (isUrgent(t) || within12h(t)));

  const Q2 = all.filter(t => isImportant(t) && !(isUrgent(t) || within12h(t)));

  const Q3 = all.filter(t => !isImportant(t) &&  (isUrgent(t) || within12h(t)));

  const Q4 = all.filter(t => !isImportant(t) && !(isUrgent(t) || within12h(t)));

  

  // 排序规则：未完成在前 → 各组内部按 due 升序

  const sortGroup = (list) => {

    const open = list.filter(t => !t.completed).sort(byDue);

    const done = list.filter(t =>  t.completed).sort((a,b) => {

      // 已完成的按完成日期倒序（最近完成的排前面）

      const da = a.done ? dv.date(a.done).ts : 0;

      const db = b.done ? dv.date(b.done).ts : 0;

      return db - da;

    });

    return [...open, ...done];

  };

  

  const grid = container.createEl("div", { cls: "q-grid" });

  renderQuadrant(grid, "🟥 Q1 重要 & 紧急",     COLORS.Q1, sortGroup(Q1), "Q1");

  renderQuadrant(grid, "🟧 Q2 重要 & 不紧急",   COLORS.Q2, sortGroup(Q2), "Q2");

  renderQuadrant(grid, "🟨 Q3 紧急 & 不重要",   COLORS.Q3, sortGroup(Q3), "Q3");

  renderQuadrant(grid, "⬜ Q4 不重要 & 不紧急", COLORS.Q4, sortGroup(Q4), "Q4");

}

function renderQuadrant(grid, title, color, list, qid) {

  const box = grid.createEl("div", { cls: "q-box" });

  const head = box.createEl("div", { cls: "q-head" });

  head.style.background = color;

  head.createEl("span", { text: title });

  

  // 头部计数：未完成 / 总数

  const openCount = list.filter(t => !t.completed).length;

  head.createEl("span", { text: `${openCount} / ${list.length}` });

  

  const body = box.createEl("div", { cls: "q-body" });

  body.dataset.qid = qid;

  

  body.addEventListener("dragover", e => { e.preventDefault(); body.classList.add("drop-hover"); });

  body.addEventListener("dragleave", () => body.classList.remove("drop-hover"));

  body.addEventListener("drop", async (e) => {

    e.preventDefault();

    body.classList.remove("drop-hover");

    const idx = Number(e.dataTransfer.getData("text/idx"));

    if (Number.isNaN(idx)) return;

    const targetQ = body.dataset.qid;

    const imp = (targetQ === "Q1" || targetQ === "Q2");

    const urg = (targetQ === "Q1" || targetQ === "Q3");

    const tasks = await loadTasks();

    const t = tasks.find(x => x.idx === idx);

    if (!t) return;

    const newT = { ...t, important: imp, urgent: urg, modified: todayStr };

    await writeTaskAtIndex(idx, newT);

    setTimeout(render, 60);

  });

  

  if (list.length === 0) {

    body.createEl("div", { cls: "q-empty", text: "— 无 —" });

    return;

  }

  

  // 在第一个已完成任务前插入分隔线

  let dividerInserted = false;

  

  for (const t of list) {

    // 当遇到第一个已完成任务时插入分隔线

    if (t.completed && !dividerInserted && list.some(x => !x.completed)) {

      body.createEl("div", { cls: "q-divider", text: "已完成 ↓" });

      dividerInserted = true;

    }

  

    const row = body.createEl("div", { cls: "q-item" + (t.completed?" done":"") });

    row.draggable = true;

    row.addEventListener("dragstart", (e) => {

      e.dataTransfer.setData("text/idx", String(t.idx));

      row.classList.add("dragging");

    });

    row.addEventListener("dragend", () => row.classList.remove("dragging"));

  

